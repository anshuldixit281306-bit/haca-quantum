# ==========================================
# QuantumLearn Backend Environment
# Copy this file to .env (overwrite it) for offline operation.
# ==========================================

PROJECT_NAME=Mac & Quantum
PROJECT_VERSION=0.1.0
DEBUG=True

# Local SQLite database (works offline, no server required)
DATABASE_URL=sqlite:///./quantumlearn.db
# PostgreSQL is supported for production deployments:
# DATABASE_URL=postgresql+psycopg://quantumlearn:password@localhost:5432/quantumlearn

# JWT
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ----------------------------------------------------------
# AI PROVIDER — OFFLINE MODE (default)
# ----------------------------------------------------------
# AI_PROVIDER=local uses the built-in offline knowledge base.
# It NEVER makes network requests and requires no API keys.
AI_PROVIDER=local
OPENAI_MODEL=gpt-5-mini

# These service endpoints are only used if you re-enable a
# cloud provider. They are NOT contacted in offline mode.
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash-0731

# API keys (leave blank for offline operation, or supply keys for cloud AI)
# OPENAI_API_KEY=your_openai_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# NVIDIA_API_KEY=your_nvidia_api_key_here


# AI_PROVIDER=groq          # switch back to cloud AI when online

VITE_API_BASE_URL=http://127.0.0.1:8000
